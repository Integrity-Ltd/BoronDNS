$ORIGIN alpha.test.
$TTL 3600
@ IN SOA ns1.alpha.test. hostmaster.alpha.test. (
    2026052404 ; serial
    60         ; refresh
    30         ; retry
    300        ; expire
    300        ; minimum
)
  IN NS ns1.alpha.test.
ns1 IN A 127.0.0.1
www IN A 192.0.2.10
mail IN A 192.0.2.20
alias IN CNAME www.alpha.test.
txt IN TXT "knot dnssec interop fixture"
_sip._tcp IN SRV 10 20 5060 www.alpha.test.
